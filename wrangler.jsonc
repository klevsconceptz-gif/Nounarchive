{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nounarchive",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nounarchive",
      "database_id": "3e02672a-331a-4624-8256-21f7432e232b",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
