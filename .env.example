PORT=3000
# Persistent SQLite file, never place in public/.
DATABASE_PATH=data/nounarchive.sqlite
# Configure a strong password locally or through hosting secrets; no default.
# ADMIN_PASSWORD=
# DISABLE_SYNC=1

# Owner-assisted recovery: generate with npm run admin:recovery-token.
# Private, short-lived expiry$token-digest value, never the raw token.
# ADMIN_RESET_TOKEN_HASH=
