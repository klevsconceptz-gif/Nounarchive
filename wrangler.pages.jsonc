{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "nounarchive",
 "pages_build_output_dir": "./public",
 "compatibility_date": "2026-10-30",
 "compatibility_flags": ["nodejs_compat"],
 "d1_databases": [{"binding": "DB", "database_name": "nounarchive", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "cloudflare/migrations"}]
}
