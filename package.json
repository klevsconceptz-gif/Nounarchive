{
  "name": "nounarchive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run cf:check && npm run pages:build && node --test",
    "admin:recovery-token": "node scripts/admin-recovery-token.js",
    "admin:setup": "node scripts/setup-admin.js",
    "news:sync": "node scripts/sync-news.js",
    "db:init": "node scripts/db-init.js",
    "db:backup": "node scripts/db-backup.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "node scripts/cf-configure.js --check && wrangler deploy",
    "cf:check": "wrangler deploy --dry-run --outdir dist/worker",
    "cf:db:create": "wrangler d1 create nounarchive",
    "cf:db:local": "wrangler d1 migrations apply nounarchive --local",
    "cf:db:remote": "node scripts/cf-configure.js --check && wrangler d1 migrations apply nounarchive --remote",
    "cf:admin-hash": "node scripts/cf-admin-hash.js",
    "pages:dev": "npm run pages:build && node scripts/pages-command.js dev",
    "pages:build": "wrangler pages functions build functions --outdir dist/pages --compatibility-date 2026-10-30 --compatibility-flags nodejs_compat && node scripts/pages-stage.js",
    "pages:deploy": "node scripts/cf-configure.js --check && npm run pages:build && node scripts/pages-command.js deploy",
    "cf:deploy:scheduler": "node scripts/cf-configure.js --check && wrangler deploy --config wrangler.scheduler.jsonc",
    "cf:configure": "node scripts/cf-configure.js",
    "cf:export": "node scripts/cf-export.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "hono": "^4.13.14"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "miniflare": "^5.20261023.3-beta",
    "wrangler": "^4.156.0",
    "yaml": "^2.9.1"
  }
}
